# ------------------------------------------------------------
# 1) Server-seitig (nur für den Node.js-Backend-Prozess)
#    Diese Werte verlassen den Server nicht und landen NICHT
#    im ausgelieferten Browser-Bundle.
# ------------------------------------------------------------

# Port, auf dem der Backend-Prozess lauscht (Standard: 3000).
PORT=3000

