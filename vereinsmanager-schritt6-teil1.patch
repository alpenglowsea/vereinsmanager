index b2ac1c8..0000000
--- a/docker-compose.yml
+++ /dev/null
@@ -1,119 +0,0 @@
-# ==========================================================
-#  VereinsManager auf einem eigenen Server / NAS
-#
-#  Starten:   docker compose up -d --build
-#  Erreichbar unter:  http://[Server-IP]:8080
-#  Anhalten:  docker compose down
-#
-#  Werte für die Supabase-Daten liest Docker Compose automatisch aus
-#  einer Datei namens ".env" neben dieser Datei. Vorlage dafür ist
-#  ".env.example".
-# ==========================================================
-
-# Die frühere Zeile "version: '3.8'" ist entfallen: Sie wird von
-# heutigen Docker-Fassungen ignoriert und nur noch als veraltet
-# angemahnt.
-
-services:
-  vereinsmanager:
-    build:
-      context: .
-      dockerfile: Dockerfile
-      args:
-        # Nur nötig, wenn der Verein den Cloud-/Team-Modus nutzen
-        # will UND die Zugangsdaten fest einbauen möchte. Sonst
-        # leer lassen und in der App unter Einstellungen →
-        # Cloud-Synchronisation eintragen.
-        #
-        # Diese Werte MÜSSEN hier unter "args" stehen und nicht
-        # unten unter "environment": Sie werden beim Bauen in das
-        # Browser-JavaScript geschrieben. Unten hätten sie keine
-        # Wirkung. Zu beachten: Wer sie hier einträgt, muss nach
-        # jeder Änderung neu bauen (--build).
-        VITE_SUPABASE_URL: "${VITE_SUPABASE_URL:-}"
-        VITE_SUPABASE_ANON_KEY: "${VITE_SUPABASE_ANON_KEY:-}"
-        VITE_DEPLOYMENT_MODE: "${VITE_DEPLOYMENT_MODE:-local}"
-
-    container_name: vereinsmanager_app
-    restart: unless-stopped
-
-    ports:
-      # Links der Port auf dem Server, rechts der im Container.
-      # Ist 8080 schon belegt (auf einer Synology häufig der Fall),
-      # einfach die linke Zahl ändern, z. B. "8081:3000".
-      - "8080:3000"
-
-    environment:
-      NODE_ENV: production
-      PORT: 3000
-
-      # Zugriffsschlüssel für die /api-Endpunkte. Bleibt er leer, würfelt
-      # der Server beim ersten Start selbst einen aus und zeigt ihn an:
-      #
-      #     docker compose logs vereinsmanager | grep -A2 Zugriffs
-      #
-      # Er ist dann einmal je Browser unter Einstellungen → Allgemein
-      # einzutragen. Wer das vermeiden will, trägt hier einen eigenen
-      # Wert ein (mindestens 24 Zeichen) — dann bleibt er auch nach
-      # einem "docker compose down -v" derselbe.
-      VM_ACCESS_KEY: "${VM_ACCESS_KEY:-}"
-
-      # Nur für den Cloud-/Team-Betrieb: Mit diesen beiden Werten kann der
-      # Server das Anmeldetoken eines Benutzers bei Supabase nachprüfen.
-      # Dann genügt die normale Anmeldung in der App, und niemand muss
-      # einen Zugriffsschlüssel eintragen. Es sind dieselben Werte wie
-      # oben unter "args", hier aber für den Serverprozess.
-      SUPABASE_URL: "${VITE_SUPABASE_URL:-}"
-      SUPABASE_ANON_KEY: "${VITE_SUPABASE_ANON_KEY:-}"
-
-    volumes:
-      # Hier liegt der Zugriffsschlüssel für die /api-Endpunkte. Ohne
-      # dieses Volume wäre er nach jedem "docker compose up --build" weg
-      # und jedes Vorstandsmitglied müsste ihn neu eintragen.
-      #
-      # Bewusst ein benanntes Volume und kein Ordner vom Server: Ein
-      # eingehängter Ordner behält die Rechte des Servers, und auf einer
-      # Synology passt die Benutzernummer meist nicht zu der im
-      # Container — der Server könnte dann nicht hineinschreiben.
-      #
-      # Hineinschauen:  docker compose exec vereinsmanager ls -l /app/daten
-      # Ganz entfernen: docker compose down -v
-      - vereinsmanager_daten:/app/daten
-
-    labels:
-      - "com.centurylinklabs.watchtower.enable=true"
-
-volumes:
-  vereinsmanager_daten:
-
-# ----------------------------------------------------------
-#  Wo liegen die Daten?
-#
-#  Dieser Container liefert die Anwendung aus und rechnet — eine
-#  Datenbank enthält er nicht. Das oben eingerichtete Volume fasst
-#  keine Vereinsdaten, sondern nur den Zugriffsschlüssel.
-#  Wo die Vereinsdaten landen, entscheidet der Betriebsmodus, den die
-#  App unter Einstellungen → Cloud-Synchronisation kennt:
-#
-#  Lokalbetrieb (Vorgabe):
-#    Die Daten liegen in der IndexedDB des jeweiligen Browsers, also
-#    auf dem Rechner des Anwenders. Zwei Vorstandsmitglieder, die
-#    dieselbe Adresse aufrufen, arbeiten dann mit zwei getrennten
-#    Beständen. Und wer im Browser "Websitedaten löschen" wählt,
-#    löscht damit die Vereinsdaten.
-#
-#  Cloud-Betrieb (Supabase eingerichtet):
-#    Die Daten liegen in der Supabase-Datenbank. Alle Vorstands-
-#    mitglieder sehen denselben Bestand, jeder mit seinem eigenen
-#    Konto und den Rechten, die ihm zugeteilt wurden — unabhängig
-#    davon, von welchem Gerät er sich anmeldet. Die IndexedDB dient
-#    dann nur noch als Zwischenspeicher, damit die App auch bei
-#    kurzer Störung der Verbindung weiterläuft.
-#
-#  Wer also gemeinsam arbeiten will, braucht den Cloud-Betrieb — auch
-#  dann, wenn dieser Container auf dem eigenen NAS läuft. Ein eigener
-#  Server allein ersetzt die Datenbank nicht.
-#
-#  In beiden Fällen gilt: regelmäßig über Einstellungen →
-#  Datensicherung sichern.
-# ----------------------------------------------------------
diff --git a/nginx.conf b/nginx.conf
deleted file mode 100644
index 180324c..0000000
--- a/nginx.conf
+++ /dev/null
@@ -1,65 +0,0 @@
-# ==========================================================
-#  OPTIONAL — wird vom Docker-Container NICHT verwendet.
-#
-#  Bis Fassung 1.2.3 hat der Container die Oberfläche mit einem
-#  nginx ausgeliefert. Das war falsch: Das Backend (server.ts) war
-#  gar nicht im Image, und die Zeile "try_files ... /index.html"
-#  hat auf jeden /api/-Aufruf die HTML-Startseite zurückgegeben, statt
-#  einer echten Antwort. Der Container startet jetzt den
-#  Express-Server selbst — nginx ist dafür nicht mehr nötig.
-#
-#  Diese Datei bleibt als Vorlage für einen Fall erhalten, der in
-#  Vereinen häufig vorkommt: Der VereinsManager läuft im Container
-#  auf Port 8080, soll aber unter einer richtigen Adresse mit
-#  Verschlüsselung erreichbar sein, z. B.
-#  https://verwaltung.mein-verein.de. Dann steht ein nginx DAVOR
-#  und reicht alles durch.
-#
-#  Verwendung: Diese Datei auf dem Server nach
-#  /etc/nginx/sites-available/vereinsmanager kopieren, die Adresse
-#  anpassen, aktivieren, und das Zertifikat mit
-#  "certbot --nginx -d verwaltung.mein-verein.de" einrichten.
-#  Certbot trägt die Zertifikatszeilen selbst ein.
-#
-#  Wer stattdessen nur den fertigen Inhalt von dist/ auf einen
-#  klassischen Webspace legt: Dort fehlt das Backend ebenfalls, und
-#  alle /api/-Aufrufe (z. B. die eigene Benutzerverwaltung) scheitern.
-# ==========================================================
-
-server {
-    listen 80;
-    server_name verwaltung.mein-verein.de;
-
-    # Große Anhänge: Belege und eingescannte Aufnahmeanträge werden
-    # als Base64 übertragen. Der Standardwert von 1 MB reicht dafür
-    # nicht; der Server selbst erlaubt 50 MB.
-    client_max_body_size 50m;
-
-    # Sicherheitskopfzeilen. Der Express-Server setzt dieselben
-    # bereits selbst; hier stehen sie für den Fall, dass jemand nur
-    # den Ordner dist/ ohne Backend ausliefert.
-    add_header X-Frame-Options "SAMEORIGIN" always;
-    add_header X-Content-Type-Options "nosniff" always;
-    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
-
-    # Das frühere "X-XSS-Protection" ist hier bewusst nicht mehr
-    # aufgeführt: Der Kopf ist veraltet, wird von keinem aktuellen
-    # Browser mehr beachtet und konnte in älteren Fassungen sogar
-    # neue Lücken öffnen.
-
-    location / {
-        # 8080 ist der Port aus der docker-compose.yml.
-        proxy_pass http://127.0.0.1:8080;
-
-        proxy_http_version 1.1;
-        proxy_set_header Host              $host;
-        proxy_set_header X-Real-IP         $remote_addr;
-        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
-        proxy_set_header X-Forwarded-Proto $scheme;
-
-        # Die Auswertung von Sitzungsprotokollen durch die KI kann
-        # bei langen Aufnahmen über eine Minute dauern.
-        proxy_read_timeout 300s;
-        proxy_send_timeout 300s;
-    }
-}
