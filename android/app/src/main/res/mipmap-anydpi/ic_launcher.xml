<?xml version="1.0" encoding="utf-8"?>
<!-- App-Symbol: das Otter-Logo (Wappen) auf Weiß. Die Bilder liegen je Bildschirmdichte in mipmap-*dpi;
     sie entstehen aus public/logo_transparent.png (siehe CHANGELOG 2.0.0). Die einfarbige Fassung nutzt Android
     bei eingeschalteten „Designten Symbolen“. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
