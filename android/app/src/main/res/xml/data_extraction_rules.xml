<?xml version="1.0" encoding="utf-8"?>
<!-- Vereinsdaten gehören nicht in Googles Cloud-Sicherung oder auf Gerätewechsel-Übertragungen:
     Der Weg ist ausschließlich die Sicherungsdatei, die der Benutzer selbst anlegt. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
