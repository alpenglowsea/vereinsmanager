# ==========================================================
#  OPTIONAL — Alternative zu nginx.conf, wird vom Docker-Container
#  NICHT verwendet und muss separat betrieben werden.
#
#  Für denselben Zweck wie nginx.conf: Der VereinsManager läuft im
#  Container auf Port 8080 und soll unter einer richtigen, mit
#  HTTPS verschlüsselten Adresse erreichbar sein, z. B.
#  https://verwaltung.mein-verein.de — über Portweiterleitung am
#  Router und eine DynDNS-Adresse, nicht über einen
#  Drittanbieter-Tunnel.
#
#  Der Unterschied zu nginx.conf: Bei Caddy entfällt der separate
#  certbot-Schritt. Caddy holt sich das Let's-Encrypt-Zertifikat für
#  die eingetragene Adresse selbständig beim ersten Start, erneuert
#  es von selbst, bevor es abläuft, und braucht dafür außer dieser
#  einen Datei keine weitere Einrichtung. Für einen Verein ohne
#  eigene Erfahrung mit Zertifikaten ist das der Weg mit den
#  wenigsten Schritten — der Preis dafür ist ein zusätzliches
#  Programm, das eingerichtet und aktuell gehalten werden will,
#  genau wie ein nginx auch.
#
#  Voraussetzung, wie bei nginx.conf auch: Am Router muss Port 443
#  (und für die einmalige Zertifikatsausstellung auch Port 80) auf
#  diesen Rechner weitergeleitet sein, und die DynDNS-Adresse muss
#  bereits auf die eigene Internetadresse zeigen.
#
#  Verwendung (Beispiel mit Docker):
#
#    1. Diese Datei nach "Caddyfile" umbenennen und die Adresse in
#       Zeile 33 anpassen.
#    2. In der docker-compose.yml einen weiteren Dienst ergänzen,
#       etwa:
#
#         caddy:
#           image: caddy:2-alpine
#           restart: unless-stopped
#           ports:
#             - "80:80"
#             - "443:443"
#           volumes:
#             - ./Caddyfile:/etc/caddy/Caddyfile
#             - caddy_data:/data
#             - caddy_config:/config
#
#       (und "caddy_data"/"caddy_config" unter "volumes:" am Ende der
#       docker-compose.yml ergänzen — Caddy legt darin unter anderem
#       das Zertifikat ab; ohne dieses Volume würde bei jedem Neubau
#       des Containers ein neues angefordert, und Let's Encrypt
#       begrenzt das je Adresse und Woche.)
#
#    3. "docker compose up -d" — Caddy fordert das Zertifikat beim
#       ersten Start selbständig an. Das dauert einen Moment; bis
#       dahin ist die Adresse noch nicht erreichbar.
# ==========================================================

verwaltung.mein-verein.de {
	# Große Anhänge: Belege und eingescannte Aufnahmeanträge werden als
	# Base64 übertragen. Der Server selbst erlaubt 50 MB, Caddy muss das
	# durchlassen.
	request_body {
		max_size 50MB
	}

	# Sicherheitskopfzeilen. Der Express-Server setzt dieselben bereits
	# selbst; hier stehen sie für den Fall, dass Caddy einmal auch
	# statische Inhalte ohne das Backend ausliefert.
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 8080 ist der Port aus der docker-compose.yml. Im selben
	# Docker-Netzwerk heißt der Dienst dort "vereinsmanager" (Name des
	# Dienstes in docker-compose.yml) — nicht "127.0.0.1": Caddy läuft in
	# einem eigenen Container und müsste sonst sich selbst ansprechen.
	reverse_proxy vereinsmanager:8080 {
		# Die Auswertung von Sitzungsprotokollen durch die KI kann bei
		# langen Aufnahmen über eine Minute dauern.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
