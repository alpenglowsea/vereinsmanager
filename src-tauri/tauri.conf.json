{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VereinsManager",
  "version": "1.0.0",
  "identifier": "de.vereinsmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VereinsManager • Revisionssichere Vereinsverwaltung",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 VereinsManager. Alle Rechte vorbehalten.",
    "category": "Business",
    "shortDescription": "Revisionssichere Vereinsverwaltung",
    "longDescription": "Modulare, revisionssichere Vereinsverwaltung für Sportvereine mit Mitgliederverwaltung, Kassenbuch, SEPA-Lastschriften, Spendenquittungen und Dokumentenarchiv.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": ["de-DE"],
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": ["de-DE"]
      }
    }
  }
}
